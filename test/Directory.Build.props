<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Surefire.Generated</InterceptorsNamespaces>
        <!-- Run xunit.v3 tests on Microsoft.Testing.Platform instead of VSTest. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="Surefire"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.analyzers"/>
    </ItemGroup>

    <!--
        Wire the Surefire source generator into every test project. Tests.SourceGeneration drives
        the generator manually via CSharpGeneratorDriver, so it references the assembly directly
        instead of as an analyzer.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Surefire.Tests.SourceGeneration'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Surefire.SourceGeneration\Surefire.SourceGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
